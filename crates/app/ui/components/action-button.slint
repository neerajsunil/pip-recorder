import { Theme } from "../theme.slint";

// Icon/text button with hover, focus and keyboard activation.
// Default is a white outlined button; `primary` is lilac, `danger` is coral
// (Record/Stop), `quiet` has no fill until hovered. `pill` rounds the ends.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> label: text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> quiet: false;
    in property <bool> pill: false;
    in property <bool> enabled: true;
    in property <length> icon-size: 18px;
    in property <length> font-size: 13px;
    callback clicked();
    private property <bool> filled: primary || danger;
    forward-focus: focus;
    accessible-role: button; accessible-label: label; accessible-enabled: enabled;
    height: 36px;
    border-radius: pill ? self.height / 2 : Theme.radius-s;
    background: !enabled ? (filled ? Theme.line-strong : Theme.sunken)
        : danger ? (touch.pressed ? Theme.coral-deep.darker(8%) : touch.has-hover ? Theme.coral-deep : Theme.coral)
        : primary ? (touch.pressed ? Theme.lilac-deeper.darker(8%) : touch.has-hover ? Theme.lilac-deeper : Theme.lilac-deep)
        : touch.pressed ? Theme.line : touch.has-hover ? Theme.hover : quiet ? transparent : Theme.surface;
    border-width: focus.has-focus ? 2px : filled || quiet ? 0px : 1px;
    border-color: focus.has-focus ? Theme.lilac : Theme.line-strong;
    animate background { duration: 110ms; }
    private property <length> content-width: (root.has-icon ? root.icon-size : 0px) + (root.has-icon && root.text != "" ? 8px : 0px) + (root.text != "" ? label-text.preferred-width : 0px);
    private property <length> start: max(10px, (root.width - root.content-width) / 2);
    private property <color> tint: !root.enabled ? Theme.ink-faint : root.filled ? Theme.on-accent : Theme.ink-soft;
    if root.has-icon: Image { source: root.icon; width: root.icon-size; height: root.icon-size; x: root.start; y: (root.height - root.icon-size) / 2; colorize: root.tint; }
    label-text := Text {
        x: root.start + (root.has-icon ? root.icon-size + 8px : 0px); width: min(self.preferred-width, root.width - self.x - 10px); height: root.height;
        text: root.text; visible: root.text != "";
        color: !root.enabled ? Theme.ink-faint : root.filled ? Theme.on-accent : Theme.ink;
        font-size: root.font-size; font-weight: root.filled ? 600 : 500; vertical-alignment: center; overflow: elide;
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
