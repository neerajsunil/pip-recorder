import { Theme } from "../theme.slint";

// Text styles shared across the studio and settings.
export component FieldLabel inherits Text { color: Theme.ink-soft; font-size: 12px; font-weight: 500; }
export component SectionTitle inherits Text { color: Theme.ink; font-size: 15px; font-weight: 650; }
export component Divider inherits Rectangle { height: 1px; background: Theme.line; }
export component Hint inherits Text { color: Theme.ink-soft; wrap: word-wrap; font-size: 12px; }
export component Warning inherits Text { color: Theme.warn-ink; wrap: word-wrap; font-size: 12px; }
export component InfoLine inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> path: false;
    vertical-stretch: 0; alignment: start; spacing: 5px;
    FieldLabel { text: root.label; height: 16px; }
    Text { text: root.value; color: Theme.ink; font-size: 13px; wrap: root.path ? char-wrap : word-wrap; }
}
