import { Theme } from "../theme.slint";

// Live peak meter; turns butter near clipping and coral at clipping or on device errors.
export component AudioMeter inherits Rectangle {
    in property <float> level;
    in property <bool> enabled: true;
    in property <bool> failed: false;
    width: 72px; height: 6px; border-radius: self.height / 2; background: Theme.sunken;
    accessible-role: progress-indicator;
    accessible-label: failed ? "Audio device unavailable" : "Audio level";
    Rectangle { x: 0; width: max(root.height, parent.width * min(1, max(0, root.level))); height: parent.height; border-radius: root.height / 2;
        background: root.failed || root.level >= 0.99 ? Theme.coral : root.level > 0.85 ? Theme.butter : Theme.mint;
        opacity: root.enabled && (root.level > 0.005 || root.failed) ? 1 : 0;
    }
}
