// Live peak meter; turns amber near clipping and red at clipping or on device errors.
export component AudioMeter inherits Rectangle {
    in property <float> level;
    in property <bool> enabled: true;
    in property <bool> failed: false;
    width: 72px; height: 5px; border-radius: 2px; background: #363c49;
    accessible-role: progress-indicator;
    accessible-label: failed ? "Audio device unavailable" : "Audio level";
    Rectangle { width: parent.width * min(1, max(0, root.level)); height: parent.height; border-radius: 2px; background: root.failed || root.level >= 0.99 ? #ed7888 : root.level > 0.85 ? #e8bc70 : #81c3aa; opacity: root.enabled ? 1 : 0; }
}
