import { Theme } from "../theme.slint";
import { FieldLabel } from "labels.slint";

// One selectable display or application window in the source picker.
export component SourceRow inherits Rectangle {
    in property <string> name; in property <string> detail;
    in property <image> icon;
    in property <bool> selected; in property <bool> enabled: true;
    callback clicked();
    height: 62px; border-radius: Theme.radius-m;
    background: selected ? Theme.lilac-soft : touch.has-hover ? Theme.hover : Theme.surface;
    border-width: focus.has-focus || selected ? 2px : 1px; border-color: selected || focus.has-focus ? Theme.lilac : Theme.line;
    accessible-role: button; accessible-label: name; accessible-enabled: enabled; forward-focus: focus;
    animate background { duration: 110ms; }
    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 14px;
        Rectangle { width: 36px; height: 36px; y: (parent.height - self.height) / 2; border-radius: Theme.radius-s; background: root.selected ? Theme.surface : Theme.sunken;
            Image { source: root.icon; width: 18px; height: 18px; colorize: root.selected ? Theme.accent-ink : Theme.ink-soft; }
        }
        VerticalLayout { alignment: center; spacing: 3px;
            Text { text: root.name; color: Theme.ink; font-size: 13px; font-weight: 500; overflow: elide; }
            FieldLabel { text: root.detail; overflow: elide; }
        }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
