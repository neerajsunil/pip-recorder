// The studio window, home of Pip. Reusable widgets live in components/, settings pages and
// the source picker in pages/. Rust drives this file through the generated
// `MainWindow` API, so property and callback names here are the contract.
import { Palette, ScrollView } from "std-widgets.slint";
import { Theme, Brand } from "theme.slint";
export { Theme }
import { ActionButton } from "components/action-button.slint";
import { AudioChip } from "components/audio-chip.slint";
import { NavItem } from "components/nav-item.slint";
import { Pip, PipMood } from "components/pip.slint";
import { SourceEntry, SourcePicker } from "pages/source-picker.slint";
import { VideoPage } from "pages/video.slint";
import { AudioPage } from "pages/audio.slint";
import { ShortcutsPage } from "pages/shortcuts.slint";
import { GeneralPage } from "pages/general.slint";
import { InfoPage } from "pages/info.slint";
import { CommunityPage } from "pages/community.slint";
import { RecordingPage } from "pages/recording.slint";
import { LinkText } from "components/link-text.slint";
import { Segmented } from "components/segmented.slint";

export { SourceEntry }

export component MainWindow inherits Window {
    in property <string> window-title: Brand.name;
    in property <string> app-version;
    title: root.window-title; icon: @image-url("icon.svg");
    preferred-width: 1100px; preferred-height: 760px;
    min-width: 880px; min-height: 640px;
    background: Theme.canvas; default-font-family: "Segoe UI"; default-font-size: 13px;
        in property <[SourceEntry]> sources;
    in property <[string]> gpu-names;
    // Format (codec) first, then the encoders on this PC that can make it.
    in property <[string]> codec-names;
    in property <int> codec-list-index: 0;
    in property <int> video-codec: 0; // 0 automatic, 1 AV1, 2 HEVC, 3 H.264
    in property <[string]> encoder-names;
    in property <int> encoder-list-index: 0;
    in property <image> tray-image: @image-url("icon.svg");
    in property <bool> encoder-available: true;
    in property <string> encoder-status;
    in property <bool> nvenc-controls: false;
    in property <bool> keyframe-controls: false;
    in property <string> recording-stats: "No recording statistics yet";
    in property <string> encoder-tech;
    in property <string> bitrate-detail;
    in-out property <int> bitrate-mode: 1;
    in-out property <int> custom-bitrate: 8;
    in property <int> selected-source: -1;
    in property <bool> source-selected: false;
    in property <bool> source-is-display: true;
    in property <string> source-name: "Main display";
    in property <string> source-detail: "";
    in property <image> preview-image;
    in property <bool> preview-ready: false;
    in-out property <bool> preview-enabled: true;
    in property <string> preview-error: "";
    in property <string> destination-label: "";
    in property <bool> destination-selected: false;
    in-out property <int> fps: 30;
    in-out property <int> encoder-choice: 0;
    in-out property <int> gpu-choice: 0;
    in property <int> bitrate-mbps: 8;
    in-out property <int> nvenc-preset: 5;
    in-out property <int> keyframe-seconds: 2;
    in-out property <bool> constant-bitrate: false;
    in-out property <bool> auto-minimize: true;
    in-out property <bool> capture-cursor: true;
    in-out property <bool> quality-mode: false;
    in-out property <int> quality-level: 20;
    in property <string> shortcut-status: "Shortcut unavailable";
    in-out property <string> start-shortcut: "Ctrl+Shift+F9";
    in-out property <string> stop-shortcut: "Ctrl+Shift+F10";
    in-out property <string> active-start-shortcut: "Ctrl+Shift+F9";
    in-out property <string> active-stop-shortcut: "Ctrl+Shift+F10";
    in-out property <bool> desktop-audio: true;
    in-out property <bool> microphone-audio: false;
    in property <[string]> desktop-audio-devices;
    in property <[string]> microphone-audio-devices;
    in-out property <int> desktop-audio-device: 0;
    in-out property <int> microphone-audio-device: 0;
    in-out property <int> desktop-volume: 100;
    in-out property <int> microphone-volume: 100;
    in property <bool> audio-ready: false;
    in property <string> audio-status: "Loading audio devices…";
    in property <string> audio-details: "Not recording";
    in property <float> desktop-level: 0;
    in property <float> microphone-level: 0;
    in property <string> desktop-audio-error;
    in property <string> microphone-audio-error;
    in-out property <int> settings-page: 0;
    in-out property <bool> software-encoder: false;
    in property <int> session-state: 0;
    in property <string> elapsed: "00:00";
    in property <string> notice: "";
    in property <bool> notice-error: false;
    in property <string> issue-detail: "";
    in property <string> encoder-label: "Detecting encoders…";
    in property <string> renderer-label: "Slint software renderer · native D3D11 preview";
    in property <string> gpu-label: "Detecting graphics adapters…";
    in property <string> codec-label: "Auto";
    in property <string> hardware-details: "Querying driver capabilities…";
    in property <string> fallback-detail: "None";
    in property <string> active-encoder: "Not recording";
    in property <bool> hardware-ready: false;
    in property <bool> has-recording: false;
    in property <string> last-recording: "";
    in property <bool> capture-supported: true;
    in-out property <bool> source-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> info-open: false;
    in-out property <bool> display-tab: true;
    private property <bool> busy: session-state != 0;
    out property <bool> can-start-recording: !busy && source-selected && destination-selected && hardware-ready && encoder-available && (!(desktop-audio || microphone-audio) || audio-ready) && (!desktop-audio || desktop-audio-device >= 0) && (!microphone-audio || microphone-audio-device >= 0);
    callback refresh-sources(); callback select-source(int); callback choose-destination(); callback open-folder();
    callback toggle-recording(); callback reveal-recording(); callback open-recording(); callback show-details();
    callback settings-changed(); callback refresh-audio-devices(); callback apply-shortcuts();
    callback encoder-selected(int); callback codec-selected(int); callback format-selected(int);
    callback tray-show(); callback tray-stop();
    callback drain-recording-events();
    callback open-link(string);
    // Preview frames: Rust is woken per frame and sizes GPU frames to this area.
    // The live preview is a native window placed over this area by Rust;
    // `preview-native` is true while it shows frames.
    in property <bool> preview-native: false;
    // Called before anything is drawn over the preview area, so Rust can hide
    // the native preview first; otherwise its old pixels linger under panels.
    callback cover-preview();
    out property <length> preview-area-x: preview-well.absolute-position.x;
    out property <length> preview-area-y: preview-well.absolute-position.y;
    out property <length> preview-area-width: preview-well.width;
    out property <length> preview-area-height: preview-well.height;
    out property <color> preview-well-color: Theme.preview-well;
    out property <length> preview-radius: Theme.radius-m;
    // Nothing Slint draws may overlap the native preview while it is shown.
    out property <bool> preview-covered: root.overlay-open || root.counting-down;
    in-out property <bool> celebrate: false;
    in-out property <bool> community-open: false;

    // Where recordings go, for people: "Videos › FastRecorder" plus the full path.
    in property <string> save-folder: "Videos › FastRecorder";
    in property <string> save-folder-path;

    // Options added for Video / Audio / Recording / Appearance.
    in-out property <int> output-height: 0;
    in-out property <int> audio-bitrate: 192;
    in-out property <int> countdown-seconds: 3;
    in-out property <int> auto-stop-minutes: 0;
    in-out property <int> after-save: 0;
    in-out property <bool> show-advanced: false;

    // Expert encoder controls (Settings → Video, Advanced). Defaults match
    // fastrecorder_core::EncoderTuning::default().
    in-out property <bool> prefer-h264: false;
    in-out property <int> b-frames: -1;
    in-out property <bool> lookahead: false;
    in-out property <bool> spatial-aq: true;
    in-out property <bool> temporal-aq: false;
    in-out property <int> multipass: 1;
    in-out property <bool> low-latency: false;
    in-out property <int> max-bitrate: 0;
    in-out property <int> software-speed: 8;
    // Recording → Advanced.
    in-out property <string> file-name-pattern: "{year}-{month}-{day}-{hour}-{minute}-{second}";
    in-out property <int> process-priority: 0;

    // Theme: 0 follows Windows, 1 light, 2 dark. Rust reports the system setting.
    in-out property <int> theme-mode: 0;
    in property <bool> system-dark: false;
    out property <bool> dark-mode: root.theme-mode == 2 || (root.theme-mode == 0 && root.system-dark);
    changed dark-mode => { root.apply-theme(); }
    init => { root.apply-theme(); }
    function apply-theme() {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    // Countdown before recording. Record (or a shortcut) during it cancels.
    out property <bool> counting-down: false;
    private property <int> countdown-left: 0;
    Timer { interval: 1s; running: root.counting-down;
        triggered => {
            root.countdown-left -= 1;
            if root.countdown-left <= 0 { root.counting-down = false; root.toggle-recording(); }
        }
    }
    public function record-pressed() {
        if root.counting-down { root.counting-down = false; return; }
        if root.session-state == 0 && root.countdown-seconds > 0 && root.can-start-recording {
            root.countdown-left = root.countdown-seconds;
            root.cover-preview();
            root.counting-down = true;
            root.celebrate = false;
            return;
        }
        root.toggle-recording();
    }

    private property <bool> locked: root.busy || root.counting-down;
    private property <bool> audio-issue: (root.desktop-audio && root.desktop-audio-error != "") || (root.microphone-audio && root.microphone-audio-error != "");
    private property <PipMood> mood: root.session-state == 2 ? PipMood.recording
        : root.session-state == 3 ? PipMood.saving
        : root.notice-error || root.audio-issue ? PipMood.oops
        : root.celebrate ? PipMood.happy
        : !root.preview-enabled ? PipMood.sleepy
        : PipMood.idle;
    private property <string> status: root.counting-down ? "Recording in " + root.countdown-left + "… press Record to cancel."
        : root.notice != "" ? root.notice
        : root.audio-issue ? (root.microphone-audio && root.microphone-audio-error != "" ? "Pip can't hear your microphone." : "Pip can't hear your desktop audio.")
        : root.session-state == 1 ? "Getting ready…"
        : root.session-state == 2 ? "Recording. Stop here, from the tray or with " + root.active-stop-shortcut + "."
        : root.session-state == 3 ? "Saving your video…"
        : root.can-start-recording ? "Ready when you are."
        : "Getting things ready…";
    private property <string> resolution-label: root.output-height == 0 ? "" : "  ·  " + root.output-height + "p";
    private property <bool> overlay-open: root.source-open || root.settings-open || root.community-open;

    function close-panels() { root.source-open = false; root.settings-open = false; root.info-open = false; root.community-open = false; }
    // The Settings button's action, for the tray and diagnostics.
    public function show-settings() { root.open-settings(0); }
    function open-settings(page: int) { root.cover-preview(); root.close-panels(); root.settings-page = page; root.settings-open = true; }
    function open-community() { root.cover-preview(); root.close-panels(); root.community-open = true; }
    function open-sources() { root.cover-preview(); root.close-panels(); root.source-open = true; root.refresh-sources(); }

    VerticalLayout { padding: 22px; padding-top: 16px; padding-bottom: 14px; spacing: 14px;
        // Header: Pip, wordmark, community and settings.
        HorizontalLayout { height: 46px; spacing: 12px;
            Pip { width: 42px; height: 46px; mood: root.mood; }
            VerticalLayout { alignment: center; spacing: -2px;
                Text { text: Brand.name; color: Theme.ink; font-size: 21px; font-weight: 750; }
                Text { text: Brand.tagline; color: Theme.ink-soft; font-size: 11px; }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { width: 128px; y: 4px; height: 38px; quiet: true; pill: true; text: "Community"; icon: @image-url("icons/heart.svg"); icon-size: 17px; clicked => { root.open-community(); } }
            ActionButton { width: 112px; y: 4px; height: 38px; quiet: true; pill: true; text: "Settings"; icon: @image-url("icons/settings-2.svg"); icon-size: 17px; clicked => { root.open-settings(0); } }
        }

        // Preview card: status row, then the well the native preview covers.
        Rectangle { vertical-stretch: 1; border-radius: Theme.radius-l; background: Theme.surface; border-width: 1px; border-color: Theme.line;
            VerticalLayout { padding: 10px; spacing: 10px;
                HorizontalLayout { height: 28px; spacing: 8px; padding-left: 2px; padding-right: 2px;
                    Rectangle { width: chip.preferred-width; border-radius: 14px;
                        background: root.session-state == 2 ? Theme.coral-soft : Theme.sunken;
                        chip := HorizontalLayout { padding-left: 11px; padding-right: 12px; spacing: 7px;
                            Rectangle { width: 8px; height: 8px; y: 10px; border-radius: 4px;
                                background: root.session-state == 2 ? Theme.coral : root.preview-ready && root.preview-enabled ? Theme.mint : Theme.ink-faint;
                            }
                            Text { text: root.session-state == 2 ? "REC  " + root.elapsed : !root.preview-enabled ? "Preview off" : root.preview-ready ? "Live preview" : "Preview";
                                color: root.session-state == 2 ? Theme.coral-ink : Theme.ink; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { width: 118px; height: 28px; pill: true; has-icon: false; font-size: 12px;
                        text: root.preview-enabled ? "Hide preview" : "Show preview"; clicked => { root.preview-enabled = !root.preview-enabled; } }
                }
                preview-well := Rectangle { vertical-stretch: 1; border-radius: Theme.radius-m; background: Theme.preview-well; clip: true;
                    if root.preview-ready && root.preview-enabled && !root.preview-native: Image { source: root.preview-image; image-fit: contain; width: parent.width; height: parent.height; }
                    if !root.preview-ready || !root.preview-enabled: VerticalLayout { alignment: center; spacing: 14px; padding: 40px;
                        HorizontalLayout { alignment: center;
                            Pip { width: 76px; height: 76px; mood: !root.preview-enabled ? PipMood.sleepy : root.preview-error != "" ? PipMood.oops : root.mood; }
                        }
                        Text {
                            text: !root.preview-enabled ? "Preview is napping. Recording still works." : root.preview-error != "" ? root.preview-error : "Warming up the preview…";
                            color: Theme.ink-soft; font-size: 14px; wrap: word-wrap; horizontal-alignment: center;
                        }
                    }
                    if root.counting-down: Rectangle { background: Theme.scrim;
                        Rectangle { width: 132px; height: 132px; border-radius: 66px; background: Theme.surface;
                            Text { text: root.countdown-left; color: Theme.coral-ink; font-size: 64px; font-weight: 800; }
                        }
                    }
                }
            }
        }

        // Control dock: what to record, what to hear, and the big button.
        Rectangle { border-radius: Theme.radius-l; background: Theme.surface; border-width: 1px; border-color: Theme.line;
            VerticalLayout { padding: 14px; spacing: 12px;
                HorizontalLayout { height: 40px; spacing: 10px;
                    Rectangle { horizontal-stretch: 1; border-radius: 20px;
                        background: !root.locked && source-touch.has-hover ? Theme.hover : Theme.sunken;
                        border-width: source-focus.has-focus ? 2px : 0px; border-color: Theme.lilac;
                        opacity: root.locked ? 0.6 : 1;
                        accessible-role: button; accessible-label: "Change what to record: " + root.source-name; accessible-enabled: !root.locked;
                        accessible-action-default => { root.open-sources(); }
                        animate background { duration: 110ms; }
                        HorizontalLayout { padding-left: 6px; padding-right: 14px; spacing: 10px;
                            Rectangle { width: 28px; height: 28px; y: 6px; border-radius: 14px; background: Theme.surface;
                                Image { source: root.source-is-display ? @image-url("icons/monitor.svg") : @image-url("icons/app-window.svg"); width: 15px; height: 15px; colorize: Theme.accent-ink; }
                            }
                            Text { text: root.source-name; color: Theme.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: "Change"; color: Theme.accent-ink; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            Image { source: @image-url("icons/chevron-down.svg"); width: 14px; height: 14px; y: 13px; colorize: Theme.accent-ink; }
                        }
                        source-focus := FocusScope { enabled: !root.locked; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.open-sources(); return accept; } return reject; } }
                        source-touch := TouchArea { enabled: !root.locked; mouse-cursor: pointer; clicked => { root.open-sources(); } }
                    }
                    AudioChip { text: "Desktop audio"; icon: @image-url("icons/volume-2.svg"); checked <=> root.desktop-audio; enabled: !root.locked;
                        level: root.desktop-level; failed: root.desktop-audio-error != ""; toggled => { root.settings-changed(); } }
                    AudioChip { text: "Microphone"; icon: @image-url("icons/mic.svg"); checked <=> root.microphone-audio; enabled: !root.locked;
                        level: root.microphone-level; failed: root.microphone-audio-error != ""; toggled => { root.settings-changed(); } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout { height: 48px; spacing: 14px;
                    ActionButton { width: 184px; height: 48px; pill: true; danger: true; font-size: 15px; icon-size: 20px;
                        icon: root.session-state == 2 || root.counting-down ? @image-url("icons/stop-fill.svg") : @image-url("icons/record-dot.svg");
                        text: root.counting-down ? "Cancel · " + root.countdown-left : root.session-state == 3 ? "Saving…" : root.session-state == 1 ? "Cancel" : root.session-state == 2 ? "Stop recording" : "Record";
                        label: root.counting-down || root.session-state == 1 ? "Cancel recording" : self.text;
                        enabled: root.counting-down || root.session-state == 1 || root.session-state == 2 || root.can-start-recording;
                        clicked => { root.record-pressed(); }
                    }
                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                        Text { text: root.status; color: root.notice-error ? Theme.danger-ink : root.audio-issue && root.notice == "" ? Theme.warn-ink : Theme.ink; font-size: 13px; font-weight: 500; overflow: elide; }
                        Text { text: root.codec-label + "  ·  " + root.fps + " fps" + root.resolution-label + (root.desktop-audio || root.microphone-audio ? "  ·  " + root.audio-bitrate + " kbps audio" : "  ·  No audio"); color: Theme.ink-soft; font-size: 12px; overflow: elide; }
                    }
                    if root.notice-error: ActionButton { width: 84px; y: 6px; pill: true; has-icon: false; text: "Details"; clicked => { root.show-details(); } }
                    if root.audio-issue && !root.notice-error: ActionButton { width: 124px; y: 6px; pill: true; has-icon: false; text: "Audio settings"; clicked => { root.open-settings(1); } }
                    if root.has-recording && !root.locked: ActionButton { width: 76px; y: 6px; pill: true; text: "Play"; icon: @image-url("icons/play.svg"); icon-size: 15px; label: "Play last recording"; clicked => { root.open-recording(); } }
                    if root.has-recording && !root.locked: ActionButton { width: 128px; y: 6px; pill: true; text: "Show in folder"; has-icon: false; label: "Show last recording in its folder"; clicked => { root.reveal-recording(); } }
                }
            }
        }

        // Where recordings go, always visible.
        HorizontalLayout { height: 22px; spacing: 8px; padding-left: 6px; padding-right: 6px;
            Image { source: @image-url("icons/folder.svg"); width: 15px; height: 15px; y: 4px; colorize: Theme.ink-soft; }
            Text { text: "Saving to"; color: Theme.ink-soft; font-size: 12px; vertical-alignment: center; }
            Text { text: root.save-folder; color: Theme.ink; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            LinkText { text: "Open folder"; clicked => { root.open-folder(); } }
            LinkText { text: "Change…"; enabled: !root.locked; clicked => { root.choose-destination(); } }
            if root.has-recording && root.last-recording != "": Text { text: "Last: " + root.last-recording; color: Theme.ink-faint; font-size: 12px; vertical-alignment: center; overflow: elide; max-width: 260px; }
        }
    }

    if root.overlay-open: Rectangle { background: Theme.scrim;
        TouchArea { clicked => { root.close-panels(); } }
        panel := Rectangle { x: (parent.width - self.width) / 2; y: 24px; width: root.source-open ? min(760px, parent.width - 48px) : min(940px, parent.width - 48px); height: parent.height - 48px;
            border-radius: Theme.radius-l; background: Theme.canvas; border-color: Theme.line; border-width: 1px;
            drop-shadow-blur: 40px; drop-shadow-color: #00000040; drop-shadow-offset-y: 12px;
            TouchArea { }
            VerticalLayout { padding: 24px; spacing: 20px;
                HorizontalLayout { height: 36px; spacing: 14px;
                    Text { text: root.source-open ? "What should " + Brand.name + " record?" : root.community-open ? "Community" : "Settings"; color: Theme.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.settings-open: Segmented { width: 210px; options: ["Simple", "Advanced"]; current: root.show-advanced ? 1 : 0;
                        selected(index) => { root.show-advanced = index == 1; root.settings-changed(); } }
                    ActionButton { width: 36px; pill: true; quiet: true; icon: @image-url("icons/x.svg"); label: "Close panel"; clicked => { root.close-panels(); } }
                }
                if root.source-open: SourcePicker {
                    busy: root.locked; sources: root.sources; selected-source: root.selected-source;
                    display-tab <=> root.display-tab;
                    refresh-sources => { root.refresh-sources(); }
                    select-source(index) => { root.select-source(index); }
                }
                if root.community-open: ScrollView { vertical-stretch: 1; content-width: self.visible-width;
                    VerticalLayout { width: panel.width - 52px; alignment: start; padding: 2px;
                        CommunityPage { open-link(url) => { root.open-link(url); } }
                    }
                }
                if root.settings-open: HorizontalLayout { spacing: 24px;
                    VerticalLayout { width: 168px; horizontal-stretch: 0; alignment: start; spacing: 4px;
                        NavItem { text: "Video"; icon: @image-url("icons/video.svg"); selected: root.settings-page == 0 && !root.info-open; clicked => { root.settings-page = 0; root.info-open = false; } }
                        NavItem { text: "Audio"; icon: @image-url("icons/volume-2.svg"); selected: root.settings-page == 1 && !root.info-open; clicked => { root.settings-page = 1; root.info-open = false; } }
                        NavItem { text: "Recording"; icon: @image-url("icons/circle-dot.svg"); selected: root.settings-page == 2 && !root.info-open; clicked => { root.settings-page = 2; root.info-open = false; } }
                        NavItem { text: "Shortcuts"; icon: @image-url("icons/keyboard.svg"); selected: root.settings-page == 3 && !root.info-open; clicked => { root.settings-page = 3; root.info-open = false; } }
                        NavItem { text: "Appearance"; icon: @image-url("icons/sun.svg"); selected: root.settings-page == 4 && !root.info-open; clicked => { root.settings-page = 4; root.info-open = false; } }
                        Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; background: Theme.line; } }
                        NavItem { text: "Diagnostics"; icon: @image-url("icons/info.svg"); selected: root.info-open; clicked => { root.info-open = true; } }
                        NavItem { text: "Community"; icon: @image-url("icons/heart.svg"); selected: false; clicked => { root.open-community(); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                    Rectangle { border-radius: Theme.radius-m; background: Theme.surface; border-width: 1px; border-color: Theme.line;
                    ScrollView { x: 0; y: 0; width: parent.width; height: parent.height; content-width: self.visible-width;
                        VerticalLayout { width: panel.width - 288px; alignment: start; spacing: 18px; padding: 24px;
                            if !root.info-open && root.settings-page == 0: VideoPage {
                                busy: root.busy; advanced: root.show-advanced; hardware-ready: root.hardware-ready; gpu-names: root.gpu-names; encoder-names: root.encoder-names; codec-names: root.codec-names;
                                codec-list-index: root.codec-list-index; video-codec: root.video-codec; encoder-label: root.encoder-label;
                                bitrate-detail: root.bitrate-detail; nvenc-controls: root.nvenc-controls; keyframe-controls: root.keyframe-controls;
                                gpu-choice <=> root.gpu-choice; encoder-list-index: root.encoder-list-index; fps <=> root.fps; output-height <=> root.output-height;
                                capture-cursor <=> root.capture-cursor;
                                bitrate-mode <=> root.bitrate-mode; custom-bitrate <=> root.custom-bitrate; nvenc-preset <=> root.nvenc-preset;
                                quality-mode <=> root.quality-mode; constant-bitrate <=> root.constant-bitrate; quality-level <=> root.quality-level;
                                keyframe-seconds <=> root.keyframe-seconds;
                                software-encoder: root.encoder-choice == 8;
                                b-frames <=> root.b-frames; lookahead <=> root.lookahead;
                                spatial-aq <=> root.spatial-aq; temporal-aq <=> root.temporal-aq; multipass <=> root.multipass;
                                low-latency <=> root.low-latency; max-bitrate <=> root.max-bitrate; software-speed <=> root.software-speed;
                                bitrate-mbps: root.bitrate-mbps;
                                settings-changed => { root.settings-changed(); }
                                encoder-selected(index) => { root.encoder-selected(index); }
                                codec-selected(index) => { root.codec-selected(index); }
                                format-selected(index) => { root.format-selected(index); }
                            }
                            if !root.info-open && root.settings-page == 1: AudioPage {
                                busy: root.busy; advanced: root.show-advanced; audio-ready: root.audio-ready; audio-status: root.audio-status;
                                desktop-audio-devices: root.desktop-audio-devices; microphone-audio-devices: root.microphone-audio-devices;
                                desktop-level: root.desktop-level; microphone-level: root.microphone-level;
                                desktop-audio-error: root.desktop-audio-error; microphone-audio-error: root.microphone-audio-error;
                                desktop-audio <=> root.desktop-audio; microphone-audio <=> root.microphone-audio;
                                desktop-audio-device <=> root.desktop-audio-device; microphone-audio-device <=> root.microphone-audio-device;
                                desktop-volume <=> root.desktop-volume; microphone-volume <=> root.microphone-volume;
                                audio-bitrate <=> root.audio-bitrate;
                                settings-changed => { root.settings-changed(); }
                                refresh-audio-devices => { root.refresh-audio-devices(); }
                            }
                            if !root.info-open && root.settings-page == 2: RecordingPage {
                                busy: root.busy; advanced: root.show-advanced;
                                save-folder: root.save-folder; save-folder-path: root.save-folder-path;
                                countdown-seconds <=> root.countdown-seconds; auto-minimize <=> root.auto-minimize;
                                after-save <=> root.after-save; auto-stop-minutes <=> root.auto-stop-minutes;
                                file-name-pattern <=> root.file-name-pattern; process-priority <=> root.process-priority;
                                source-name: root.source-name; next-file: root.destination-label;
                                settings-changed => { root.settings-changed(); }
                                choose-folder => { root.choose-destination(); }
                                open-folder => { root.open-folder(); }
                            }
                            if !root.info-open && root.settings-page == 3: ShortcutsPage {
                                busy: root.busy; shortcut-status: root.shortcut-status;
                                start-shortcut <=> root.start-shortcut; stop-shortcut <=> root.stop-shortcut;
                                apply-shortcuts => { root.apply-shortcuts(); }
                            }
                            if !root.info-open && root.settings-page == 4: GeneralPage {
                                app-version: root.app-version;
                                theme-mode <=> root.theme-mode;
                                settings-changed => { root.settings-changed(); }
                            }
                            if root.info-open: InfoPage {
                                issue-detail: root.issue-detail; gpu-label: root.gpu-label; encoder-status: root.encoder-status;
                                encoder-label: root.encoder-label; active-encoder: root.active-encoder; audio-details: root.audio-details;
                                recording-stats: root.recording-stats; renderer-label: root.renderer-label; encoder-tech: root.encoder-tech;
                                fallback-detail: root.fallback-detail; hardware-details: root.hardware-details;
                            }
                            Rectangle { min-height: 1px; vertical-stretch: 1; }
                        }
                    }
                    }
                }
            }
        }
    }
}
