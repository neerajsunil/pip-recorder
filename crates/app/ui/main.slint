import { ScrollView, ComboBox, SpinBox, CheckBox, LineEdit, Palette } from "std-widgets.slint";
export struct SourceEntry { name: string, detail: string, index: int }

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> label: text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: focus;
    accessible-role: button; accessible-label: label; accessible-enabled: enabled;
    border-radius: 7px;
    background: !enabled ? #242730 : danger ? (touch.has-hover ? #ce4053 : #b93547) : primary ? (touch.has-hover ? #6e60dc : #5d50c6) : (touch.has-hover ? #343844 : #292d37);
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? #a99eff : primary || danger ? transparent : #3a3e49;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: 100ms; }
    height: 36px;
    if root.has-icon: Image { source: root.icon; width: 18px; height: 18px; x: root.text == "" ? (root.width - 18px) / 2 : 12px; y: (root.height - 18px) / 2; colorize: root.primary || root.danger ? #ffffff : #c5c8d3; }
    if root.text != "": Text { x: root.has-icon ? 38px : 10px; width: root.width - self.x - 10px; height: root.height; text: root.text; color: #eef0f6; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
component FieldLabel inherits Text { color: #a2a8b9; font-size: 12px; }
component InfoLine inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> path: false;
    vertical-stretch: 0; alignment: start; spacing: 5px;
    FieldLabel { text: root.label; height: 16px; }
    Text { text: root.value; color: #e2e5ee; font-size: 13px; wrap: root.path ? char-wrap : word-wrap; }
}
component SourceRow inherits Rectangle {
    in property <string> name; in property <string> detail;
    in property <bool> selected; in property <bool> enabled: true;
    callback clicked();
    height: 62px; border-radius: 7px;
    background: selected ? #343047 : touch.has-hover ? #2d313b : #242831;
    border-width: focus.has-focus ? 2px : 1px; border-color: selected || focus.has-focus ? #8778dd : #383d49;
    accessible-role: button; accessible-label: name; accessible-enabled: enabled; forward-focus: focus;
    VerticalLayout { padding: 12px; spacing: 4px;
        Text { text: root.name; color: #edf0f8; font-size: 13px; overflow: elide; }
        FieldLabel { text: root.detail; overflow: elide; }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
export component MainWindow inherits Window {
    in property <string> window-title: "FastRecorder";
    in property <string> app-version;
    title: root.window-title; icon: @image-url("icon.svg");
    preferred-width: 1100px; preferred-height: 760px;
    min-width: 880px; min-height: 640px;
    background: #1b1e26; default-font-family: "Segoe UI"; default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in property <[SourceEntry]> sources;
    in property <[string]> gpu-names;
    in property <[string]> encoder-names;
    in-out property <int> encoder-list-index: 0;
    in property <image> tray-image: @image-url("icon.svg");
    in property <bool> encoder-available: true;
    in property <string> encoder-status;
    in property <bool> nvenc-controls: false;
    in property <bool> keyframe-controls: false;
    in property <string> recording-stats: "No recording statistics yet";
    in property <string> encoder-tech;
    in property <string> bitrate-detail;
    in-out property <int> bitrate-mode: 1;
    in-out property <int> custom-bitrate: 8;
    in property <int> selected-source: -1;
    in property <bool> source-selected: false;
    in property <bool> source-is-display: true;
    in property <string> source-name: "Main display";
    in property <string> source-detail: "";
    in property <image> preview-image;
    in property <bool> preview-ready: false;
    in-out property <bool> preview-enabled: true;
    in property <string> preview-error: "";
    in property <string> destination-label: "";
    in property <bool> destination-selected: false;
    in-out property <int> fps: 30;
    in-out property <int> encoder-choice: 0;
    in-out property <int> gpu-choice: 0;
    in property <int> bitrate-mbps: 8;
    in-out property <int> nvenc-preset: 5;
    in-out property <int> keyframe-seconds: 2;
    in-out property <bool> constant-bitrate: false;
    in-out property <bool> auto-minimize: true;
    in-out property <bool> capture-cursor: true;
    in-out property <bool> quality-mode: false;
    in-out property <int> quality-level: 20;
    in property <string> shortcut-status: "Shortcut unavailable";
    in-out property <string> start-shortcut: "Ctrl+Shift+F9";
    in-out property <string> stop-shortcut: "Ctrl+Shift+F10";
    in-out property <string> active-start-shortcut: "Ctrl+Shift+F9";
    in-out property <string> active-stop-shortcut: "Ctrl+Shift+F10";
    in-out property <bool> desktop-audio: true;
    in-out property <bool> microphone-audio: false;
    in property <[string]> desktop-audio-devices;
    in property <[string]> microphone-audio-devices;
    in-out property <int> desktop-audio-device: 0;
    in-out property <int> microphone-audio-device: 0;
    in-out property <int> desktop-volume: 100;
    in-out property <int> microphone-volume: 100;
    in property <bool> audio-ready: false;
    in property <string> audio-status: "Loading audio devices…";
    in property <string> audio-details: "Not recording";
    in-out property <int> settings-page: 0;
    in-out property <bool> software-encoder: false;
    in property <int> session-state: 0;
    in property <string> elapsed: "00:00";
    in property <string> notice: "";
    in property <bool> notice-error: false;
    in property <string> encoder-label: "Detecting encoders…";
    in property <string> renderer-label: "WGPU · Direct3D 12";
    in property <string> gpu-label: "Detecting graphics adapters…";
    in property <string> codec-label: "Auto";
    in property <string> hardware-details: "Querying driver capabilities…";
    in property <string> fallback-detail: "None";
    in property <string> active-encoder: "Not recording";
    in property <bool> hardware-ready: false;
    in property <bool> has-recording: false;
    in property <string> last-recording: "";
    in property <bool> capture-supported: true;
    in-out property <bool> source-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> info-open: false;
    in-out property <bool> display-tab: true;
    private property <bool> busy: session-state != 0;
    out property <bool> can-start-recording: !busy && source-selected && destination-selected && hardware-ready && encoder-available && (!(desktop-audio || microphone-audio) || audio-ready) && (!desktop-audio || desktop-audio-device >= 0) && (!microphone-audio || microphone-audio-device >= 0);
    callback refresh-sources(); callback select-source(int); callback choose-destination();
    callback toggle-recording(); callback reveal-recording(); callback open-recording(); callback show-details();
    callback settings-changed(); callback refresh-audio-devices(); callback apply-shortcuts();
    callback encoder-selected(int);
    callback tray-show(); callback tray-stop();
    callback drain-recording-events();
    VerticalLayout { padding: 20px; spacing: 16px;
        HorizontalLayout { height: 36px; spacing: 10px;
            Image { source: @image-url("icons/video.svg"); width: 22px; height: 36px; image-fit: contain; colorize: #afa3ff; }
            Text { text: "FastRecorder"; color: #f0f2f8; font-size: 17px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { width: 38px; icon: @image-url("icons/settings-2.svg"); label: "Advanced settings"; clicked => { root.settings-open = true; root.settings-page = 0; root.info-open = false; root.source-open = false; } }
        }
        Rectangle { vertical-stretch: 1; border-radius: 10px; background: #101218; border-width: 1px; border-color: #323640; clip: true;
            if root.preview-ready && root.preview-enabled: Image { source: root.preview-image; image-fit: contain; width: parent.width; height: parent.height; }
            if !root.preview-ready || !root.preview-enabled: Text {
                text: !root.preview-enabled ? "Preview hidden" : root.preview-error != "" ? root.preview-error : "Starting preview…";
                color: #9098ac; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; x: 40px; y: 40px; width: parent.width - 80px; height: parent.height - 80px;
            }
            Rectangle { x: 14px; y: 14px; width: root.session-state == 2 ? 140px : 90px; height: 28px; border-radius: 6px; background: #1b1e26e8;
                HorizontalLayout { padding: 9px; spacing: 7px;
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.session-state == 2 ? #eb586b : #a6aebf; }
                    Text { text: root.session-state == 2 ? "REC  " + root.elapsed : "Preview"; color: #e4e7ef; font-size: 11px; vertical-alignment: center; }
                }
            }
            ActionButton { x: parent.width - 116px; y: 14px; width: 102px; height: 28px; has-icon: false; text: root.preview-enabled ? "Hide preview" : "Show preview"; clicked => { root.preview-enabled = !root.preview-enabled; } }
        }
        HorizontalLayout { height: 42px; spacing: 12px;
            Image { source: root.source-is-display ? @image-url("icons/monitor.svg") : @image-url("icons/app-window.svg"); width: 20px; height: 42px; image-fit: contain; }
            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                Text { text: root.source-name; color: #e7eaf2; font-size: 13px; overflow: elide; }
            }
            ActionButton { width: 136px; text: "Change source"; icon: @image-url("icons/chevron-down.svg"); enabled: !root.busy; clicked => { root.source-open = true; root.settings-open = false; root.refresh-sources(); } }
        }
        HorizontalLayout { height: 32px; spacing: 20px;
            CheckBox { text: "Desktop audio"; checked <=> root.desktop-audio; enabled: !root.busy; toggled => { root.settings-changed(); } }
            CheckBox { text: "Microphone"; checked <=> root.microphone-audio; enabled: !root.busy; toggled => { root.settings-changed(); } }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { width: 32px; height: 32px; icon: @image-url("icons/settings-2.svg"); label: "Audio devices"; clicked => { root.settings-page = 1; root.settings-open = true; root.info-open = false; root.source-open = false; } }
        }
        Rectangle { height: 1px; background: #323640; }
        HorizontalLayout { height: 48px; spacing: 16px;
            ActionButton { width: 182px; danger: root.session-state == 2; primary: !root.busy;
                icon: root.session-state == 2 ? @image-url("icons/square.svg") : @image-url("icons/circle.svg");
                text: root.session-state == 3 ? "Saving…" : root.session-state == 1 ? "Cancel recording" : root.session-state == 2 ? "Stop recording" : "Record";
                enabled: root.session-state == 1 || root.session-state == 2 || root.can-start-recording;
                clicked => { root.toggle-recording(); }
            }
            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 5px;
                Text { text: root.codec-label + "  ·  " + root.fps + " fps"; color: #c4cad9; font-size: 13px; overflow: elide; }
            }
            ActionButton { width: 40px; icon: @image-url("icons/folder.svg"); label: "Choose where to save"; enabled: !root.busy; clicked => { root.choose-destination(); } }
        }
        HorizontalLayout { height: 26px; spacing: 8px;
            Text { text: root.notice; color: root.notice-error ? #f18b99 : #929aac; font-size: 12px; overflow: elide; vertical-alignment: center; }
            if root.notice-error: ActionButton { width: 66px; has-icon: false; text: "Details"; clicked => { root.show-details(); } }
            if root.has-recording: ActionButton { width: 88px; has-icon: false; text: "Play video"; clicked => { root.open-recording(); } }
            if root.has-recording: ActionButton { width: 134px; text: "Show in folder"; icon: @image-url("icons/folder.svg"); clicked => { root.reveal-recording(); } }
        }
    }
    if root.source-open || root.settings-open: Rectangle { background: #00000090;
        TouchArea { clicked => { root.source-open = false; root.settings-open = false; root.info-open = false; } }
        panel := Rectangle { x: (parent.width - self.width) / 2; y: 24px; width: root.source-open ? parent.width - 48px : min(900px, parent.width - 48px); height: parent.height - 48px; border-radius: 12px; background: #20242d; border-color: #414652; border-width: 1px;
            TouchArea { }
            VerticalLayout { padding: 24px; spacing: 20px;
                HorizontalLayout { height: 36px;
                    Text { text: root.source-open ? "Capture source" : root.info-open ? "Recording info" : "Advanced settings"; color: #eef1f8; font-size: 20px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }

                    Rectangle { width: 10px; }
                    ActionButton { width: 36px; icon: @image-url("icons/x.svg"); label: "Close panel"; clicked => { root.source-open = false; root.settings-open = false; root.info-open = false; } }
                }
                if root.source-open: VerticalLayout { spacing: 14px;
                    HorizontalLayout { height: 36px; spacing: 8px;
                        ActionButton { width: 124px; text: "Displays"; icon: @image-url("icons/monitor.svg"); primary: root.display-tab; clicked => { root.display-tab = true; root.refresh-sources(); } }
                        ActionButton { width: 124px; text: "Applications"; icon: @image-url("icons/app-window.svg"); primary: !root.display-tab; clicked => { root.display-tab = false; root.refresh-sources(); } }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { width: 36px; icon: @image-url("icons/refresh-cw.svg"); label: "Refresh sources"; clicked => { root.refresh-sources(); } }
                    }
                    ScrollView { vertical-stretch: 1; content-width: self.visible-width;
                        VerticalLayout { spacing: 8px; padding: 2px;
                            if root.sources.length == 0: FieldLabel { text: "No available sources. Open an application, then refresh."; }
                            for source in root.sources: SourceRow { name: source.name; detail: source.detail; selected: root.selected-source == source.index; enabled: !root.busy; clicked => { root.select-source(source.index); } }
                            Rectangle { min-height: 1px; vertical-stretch: 1; }
                        }
                    }
                }
                if root.settings-open: HorizontalLayout { spacing: 20px;
                    VerticalLayout { width: 150px; horizontal-stretch: 0; alignment: start; spacing: 8px;
                        ActionButton { text: "Video"; has-icon: false; primary: root.settings-page == 0 && !root.info-open; clicked => { root.settings-page = 0; root.info-open = false; } }
                        ActionButton { text: "Audio"; has-icon: false; primary: root.settings-page == 1 && !root.info-open; clicked => { root.settings-page = 1; root.info-open = false; } }
                        ActionButton { text: "Shortcuts"; has-icon: false; primary: root.settings-page == 2 && !root.info-open; clicked => { root.settings-page = 2; root.info-open = false; } }
                        ActionButton { text: "General"; has-icon: false; primary: root.settings-page == 3 && !root.info-open; clicked => { root.settings-page = 3; root.info-open = false; } }
                        Rectangle { height: 1px; background: #373d49; }
                        ActionButton { text: "Info"; has-icon: false; primary: root.info-open; clicked => { root.info-open = true; } }
                        Rectangle { vertical-stretch: 1; }
                    }
                    ScrollView { vertical-stretch: 1; horizontal-stretch: 1; content-width: self.visible-width;
                        VerticalLayout { width: panel.width - 244px; alignment: start; spacing: 18px; padding: 2px;
                            if !root.info-open && root.settings-page == 0: VerticalLayout { alignment: start; spacing: 16px;
                                Text { text: "Encoding"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "GPU"; }
                                    ComboBox { model: root.gpu-names; current-index <=> root.gpu-choice; enabled: !root.busy && root.hardware-ready; selected => { root.settings-changed(); } }
                                }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Encoder / codec"; }
                                    ComboBox { model: root.encoder-names; current-index <=> root.encoder-list-index; enabled: !root.busy && root.hardware-ready; selected => { root.encoder-selected(self.current-index); } }
                                }
                                Rectangle { height: 1px; background: #373d49; }
                                Text { text: "Quality"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                HorizontalLayout { spacing: 16px;
                                    VerticalLayout { spacing: 7px;
                                        FieldLabel { text: "Frame rate"; }
                                        ComboBox { model: ["30 fps", "60 fps"]; current-index: root.fps == 60 ? 1 : 0; enabled: !root.busy; selected => { root.fps = self.current-index == 1 ? 60 : 30; root.settings-changed(); } }
                                    }
                                    VerticalLayout { spacing: 7px;
                                        FieldLabel { text: "Bitrate"; }
                                        ComboBox { model: ["High", "Recommended", "Low", "Custom"]; current-index <=> root.bitrate-mode; enabled: !root.busy && !(root.quality-mode && root.nvenc-controls); selected => { root.settings-changed(); } }
                                    }
                                }
                                if root.bitrate-mode == 3 && !(root.quality-mode && root.nvenc-controls): VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Custom bitrate (Mbps)"; }
                                    SpinBox { value <=> root.custom-bitrate; minimum: 1; maximum: 100; enabled: !root.busy; edited => { root.settings-changed(); } }
                                }
                                Text { text: root.bitrate-detail; color: #a2a8b9; wrap: word-wrap; font-size: 12px; }
                                if root.nvenc-controls: VerticalLayout { spacing: 16px;
                                    VerticalLayout { spacing: 7px;
                                        FieldLabel { text: "NVENC preset"; }
                                        ComboBox { model: ["P1 · Fastest", "P2 · Faster", "P3 · Fast", "P4 · Balanced", "P5 · Quality", "P6 · Higher quality", "P7 · Highest quality"]; current-index: root.nvenc-preset - 1; enabled: !root.busy; selected => { root.nvenc-preset = self.current-index + 1; root.settings-changed(); } }
                                    }
                                    VerticalLayout { spacing: 7px;
                                        FieldLabel { text: "Rate control"; }
                                        ComboBox { model: ["VBR · bitrate", "CQP · quality", "CBR · fixed bitrate"]; current-index: root.quality-mode ? 1 : root.constant-bitrate ? 2 : 0; enabled: !root.busy; selected => { root.quality-mode = self.current-index == 1; root.constant-bitrate = self.current-index == 2; root.settings-changed(); } }
                                    }
                                    if root.quality-mode: VerticalLayout { spacing: 7px;
                                        FieldLabel { text: "Quality level · lower is better, larger files"; }
                                        SpinBox { value <=> root.quality-level; minimum: 1; maximum: 51; enabled: !root.busy; edited => { root.settings-changed(); } }
                                    }
                                }
                                if root.keyframe-controls: VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Keyframe interval (seconds)"; }
                                    SpinBox { value <=> root.keyframe-seconds; minimum: 1; maximum: 10; enabled: !root.busy; edited => { root.settings-changed(); } }
                                }
                            }
                            if !root.info-open && root.settings-page == 1: VerticalLayout { alignment: start; spacing: 16px;
                                HorizontalLayout { height: 32px;
                                    Text { text: "Desktop audio"; color: #e9ecf4; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { width: 32px; height: 32px; icon: @image-url("icons/refresh-cw.svg"); label: "Refresh audio devices"; enabled: !root.busy; clicked => { root.refresh-audio-devices(); } }
                                }
                                CheckBox { text: "Record desktop audio"; checked <=> root.desktop-audio; enabled: !root.busy; toggled => { root.settings-changed(); } }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Playback device"; }
                                    ComboBox { model: root.desktop-audio-devices; current-index <=> root.desktop-audio-device; enabled: !root.busy && root.audio-ready; selected => { root.settings-changed(); } }
                                }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Recording volume (%)"; }
                                    SpinBox { value <=> root.desktop-volume; minimum: 0; maximum: 200; enabled: !root.busy; edited => { root.settings-changed(); } }
                                }
                                Rectangle { height: 1px; background: #373d49; }
                                Text { text: "Microphone"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                CheckBox { text: "Record microphone"; checked <=> root.microphone-audio; enabled: !root.busy; toggled => { root.settings-changed(); } }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Input device"; }
                                    ComboBox { model: root.microphone-audio-devices; current-index <=> root.microphone-audio-device; enabled: !root.busy && root.audio-ready; selected => { root.settings-changed(); } }
                                }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Recording volume (%)"; }
                                    SpinBox { value <=> root.microphone-volume; minimum: 0; maximum: 200; enabled: !root.busy; edited => { root.settings-changed(); } }
                                }
                                if root.audio-status != "": Text { text: root.audio-status; color: #f0b980; wrap: word-wrap; font-size: 12px; }
                                Text { text: "Enabled sources are mixed into one stereo audio track."; color: #a2a8b9; wrap: word-wrap; font-size: 12px; }
                            }
                            if !root.info-open && root.settings-page == 2: VerticalLayout { alignment: start; spacing: 16px;
                                Text { text: "Recording actions"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Start recording"; }
                                    LineEdit { text <=> root.start-shortcut; placeholder-text: "Ctrl+Shift+F9"; enabled: !root.busy; }
                                }
                                VerticalLayout { spacing: 7px;
                                    FieldLabel { text: "Stop recording"; }
                                    LineEdit { text <=> root.stop-shortcut; placeholder-text: "Ctrl+Shift+F10"; enabled: !root.busy; }
                                }
                                Text { text: "Use Ctrl, Alt, Shift or Win with a key, or an F-key alone. Assign the same shortcut to both actions to toggle recording. Leave a field blank to disable it."; color: #a2a8b9; wrap: word-wrap; font-size: 12px; }
                                HorizontalLayout { spacing: 10px; height: 36px;
                                    ActionButton { width: 112px; text: "Apply"; has-icon: false; primary: true; enabled: !root.busy; clicked => { root.apply-shortcuts(); } }
                                    ActionButton { width: 132px; text: "Reset defaults"; has-icon: false; enabled: !root.busy; clicked => { root.start-shortcut = "Ctrl+Shift+F9"; root.stop-shortcut = "Ctrl+Shift+F10"; root.apply-shortcuts(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { text: root.shortcut-status; color: #a2a8b9; wrap: word-wrap; font-size: 12px; }
                            }
                            if !root.info-open && root.settings-page == 3: VerticalLayout { alignment: start; spacing: 16px;
                                Text { text: "Capture"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                CheckBox { text: "Include mouse cursor"; checked <=> root.capture-cursor; enabled: !root.busy; toggled => { root.settings-changed(); } }
                                Rectangle { height: 1px; background: #373d49; }
                                Text { text: "Studio"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                CheckBox { text: "Minimize when recording starts"; checked <=> root.auto-minimize; enabled: !root.busy; toggled => { root.settings-changed(); } }
                                Rectangle { height: 1px; background: #373d49; }
                                Text { text: "Saving"; color: #e9ecf4; font-size: 15px; font-weight: 600; }
                                InfoLine { label: "Next recording"; value: root.destination-label; path: true; }
                                ActionButton { height: 36px; width: 150px; text: "Change location"; icon: @image-url("icons/folder.svg"); enabled: !root.busy; clicked => { root.choose-destination(); } }
                                Rectangle { height: 1px; background: #373d49; }
                                FieldLabel { text: "FastRecorder " + root.app-version; }
                            }
                            if root.info-open: VerticalLayout { alignment: start; spacing: 16px;
                                InfoLine { label: "Selected GPU"; value: root.gpu-label; }
                                if root.encoder-status != "": InfoLine { label: "Encoder notes"; value: root.encoder-status; }
                                InfoLine { label: "Selected encoder"; value: root.encoder-label; }
                                InfoLine { label: "Verified encoder (last / current recording)"; value: root.active-encoder; }
                                InfoLine { label: "Audio (last / current recording)"; value: root.audio-details; }
                                InfoLine { label: "Recording statistics"; value: root.recording-stats; }
                                InfoLine { label: "Video pipeline"; value: "Windows Graphics Capture → D3D11 video processor → NV12 / BT.709 SDR 8-bit → MP4"; }
                                InfoLine { label: "UI renderer / preview"; value: root.renderer-label + " · preview ≤ 960 × 540 at 12 fps, paused while minimized"; }
                                InfoLine { label: "Encoder configuration"; value: root.encoder-tech; }
                                InfoLine { label: "Startup fallback"; value: root.fallback-detail; }
                                InfoLine { label: "Detected capabilities"; value: root.hardware-details; }
                            }
                            Rectangle { min-height: 1px; vertical-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
}
