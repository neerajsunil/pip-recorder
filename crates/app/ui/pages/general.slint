import { Theme, Brand } from "../theme.slint";
import { Divider, FieldLabel } from "../components/labels.slint";
import { IconSegmented } from "../components/segmented.slint";
import { SettingGroup, SettingRow } from "../components/setting-row.slint";

// Settings → Appearance: theme and version.
export component GeneralPage inherits VerticalLayout {
    in property <string> app-version;
    in-out property <int> theme-mode;
    callback settings-changed();
    alignment: start; spacing: 22px;
    SettingGroup { title: "Appearance";
        SettingRow { title: "Theme"; description: "System follows your Windows light or dark setting."; control-width: 330px;
            IconSegmented {
                options: [{ text: "System", icon: @image-url("../icons/monitor.svg") }, { text: "Light", icon: @image-url("../icons/sun.svg") }, { text: "Dark", icon: @image-url("../icons/moon.svg") }];
                current: root.theme-mode;
                selected(index) => { root.theme-mode = index; root.settings-changed(); }
            }
        }
    }
    Divider { }
    FieldLabel { text: Brand.name + " " + root.app-version; }
}
