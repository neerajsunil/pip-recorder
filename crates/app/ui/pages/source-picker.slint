import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action-button.slint";
import { FieldLabel } from "../components/labels.slint";
import { SourceRow } from "../components/source-row.slint";
import { IconSegmented } from "../components/segmented.slint";

export struct SourceEntry { name: string, detail: string, index: int }

// Capture source picker: displays and application windows.
export component SourcePicker inherits VerticalLayout {
    in property <bool> busy;
    in property <[SourceEntry]> sources;
    in property <int> selected-source;
    in-out property <bool> display-tab;
    callback refresh-sources();
    callback select-source(int);
    spacing: 14px;
    HorizontalLayout { height: 40px; spacing: 8px;
        IconSegmented { width: 300px;
            options: [{ text: "Displays", icon: @image-url("../icons/monitor.svg") }, { text: "Applications", icon: @image-url("../icons/app-window.svg") }];
            current: root.display-tab ? 0 : 1;
            selected(index) => { root.display-tab = index == 0; root.refresh-sources(); }
        }
        Rectangle { horizontal-stretch: 1; }
        ActionButton { width: 40px; height: 40px; pill: true; icon: @image-url("../icons/refresh-cw.svg"); label: "Refresh sources"; clicked => { root.refresh-sources(); } }
    }
    ScrollView { vertical-stretch: 1; content-width: self.visible-width;
        VerticalLayout { spacing: 8px; padding: 2px;
            if root.sources.length == 0: FieldLabel { text: "Nothing to record here yet. Open an application, then refresh."; }
            for source in root.sources: SourceRow {
                name: source.name; detail: source.detail; enabled: !root.busy;
                icon: root.display-tab ? @image-url("../icons/monitor.svg") : @image-url("../icons/app-window.svg");
                selected: root.selected-source == source.index;
                clicked => { root.select-source(source.index); }
            }
            Rectangle { min-height: 1px; vertical-stretch: 1; }
        }
    }
}
