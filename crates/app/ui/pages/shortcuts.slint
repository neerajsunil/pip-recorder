import { LineEdit } from "std-widgets.slint";
import { ActionButton } from "../components/action-button.slint";
import { FieldLabel, Hint, SectionTitle } from "../components/labels.slint";

// Settings → Shortcuts: global start/stop bindings.
export component ShortcutsPage inherits VerticalLayout {
    in property <bool> busy;
    in property <string> shortcut-status;
    in-out property <string> start-shortcut;
    in-out property <string> stop-shortcut;
    callback apply-shortcuts();
    alignment: start; spacing: 16px;
    SectionTitle { text: "Recording actions"; }
    VerticalLayout { spacing: 7px;
        FieldLabel { text: "Start recording"; }
        LineEdit { text <=> root.start-shortcut; placeholder-text: "Ctrl+Shift+F9"; enabled: !root.busy; }
    }
    VerticalLayout { spacing: 7px;
        FieldLabel { text: "Stop recording"; }
        LineEdit { text <=> root.stop-shortcut; placeholder-text: "Ctrl+Shift+F10"; enabled: !root.busy; }
    }
    Hint { text: "Use Ctrl, Alt, Shift or Win with a key, or an F-key alone. Assign the same shortcut to both actions to toggle recording. Leave a field blank to disable it."; }
    HorizontalLayout { spacing: 10px; height: 36px;
        ActionButton { width: 112px; text: "Apply"; has-icon: false; primary: true; enabled: !root.busy; clicked => { root.apply-shortcuts(); } }
        ActionButton { width: 132px; text: "Reset defaults"; has-icon: false; enabled: !root.busy; clicked => { root.start-shortcut = "Ctrl+Shift+F9"; root.stop-shortcut = "Ctrl+Shift+F10"; root.apply-shortcuts(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    Hint { text: root.shortcut-status; }
}
